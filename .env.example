# --- Meta WhatsApp Cloud API (customer-facing number) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App secret used to verify X-Hub-Signature-256 on inbound webhooks
WHATSAPP_APP_SECRET=
# Arbitrary string you also enter in the Meta webhook config (GET verification)
WHATSAPP_VERIFY_TOKEN=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Postgres (Supabase in prod — use the Transaction-pooler string, port 6543;
#     docker-compose locally) ---
DATABASE_URL=postgres://bills:bills@localhost:5432/bills

# --- Upstash Redis (docker-compose redis locally via ioredis-compatible URL) ---
REDIS_URL=redis://localhost:6379

# --- Upstash QStash (job queue). Leave empty locally to run jobs inline. ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public base URL QStash calls back into (ngrok URL in dev)
APP_BASE_URL=http://localhost:3000

# --- Media storage: Vercel Blob (falls back to local .blob/ dir when empty) ---
BLOB_READ_WRITE_TOKEN=

# --- Crypto ---
# 32-byte base64 master key (KEK) for envelope encryption. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENVELOPE_KEK_BASE64=
ENVELOPE_KEK_ID=local-dev-1
# Pepper for HMAC phone hashing (log correlation without PII)
WA_HASH_PEPPER=

# --- Signed summary links ---
SUMMARY_JWT_SECRET=
SUMMARY_BASE_URL=http://localhost:3000
DEV_TRY_SECRET=
